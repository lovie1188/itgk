# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=soft_sam
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application Configuration
APP_NAME="SoftSam Certificate Portal"
APP_ENV=local
APP_DEBUG=true
BASE_URL=/certificate/

# Session Configuration
SESSION_LIFETIME=7200

# SSO Configuration
SSO_ENABLED=true
SSO_URL=http://localhost/softtechsso
SSO_CLIENT_ID=certificate_portal
SSO_CLIENT_SECRET=
SSO_ASSET_URL=http://localhost/softtechsso/public/assets/

# JWT Configuration (for API authentication)
JWT_SECRET=your-secret-key-change-in-production
JWT_TTL=86400