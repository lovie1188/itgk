{
    "name": "softtech/softsam-portal",
    "description": "RS-CIT Certificate Management System - SoftSam Portal",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "phpoffice/phpspreadsheet": "^5.1",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Core\\": "app/Core/",
            "App\\Controllers\\": "app/Controllers/",
            "App\\Controllers\\Api\\": "app/Controllers/Api/",
            "App\\Controllers\\Web\\": "app/Controllers/Web/",
            "App\\Models\\": "app/Models/",
            "App\\Services\\": "app/Services/",
            "App\\Middleware\\": "app/Middleware/",
            "App\\Repositories\\": "app/Repositories/",
            "App\\Exceptions\\": "app/Exceptions/",
            "App\\Helpers\\": "app/Helpers/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=PSR12 app/",
        "cs-fix": "phpcbf --standard=PSR12 app/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
